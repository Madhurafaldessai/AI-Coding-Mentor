
# ==========================================
# SERVER CONFIGURATION
# ==========================================

PORT=4000
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_ORIGIN=http://localhost:3000


# ==========================================
# AI CONFIGURATION
# ==========================================

# Keep mock mode enabled until live AI is tested
USE_MOCK_AI=true

# Preferred AI provider order
AI_PROVIDER_ORDER=groq,gemini,cerebras,openrouter

# Groq - Primary provider
GROQ_API_KEY=
MENTOR_MODEL=llama-3.3-70b-versatile

# Google Gemini - Fallback
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=

# Cerebras - Fallback
CEREBRAS_API_KEY=
CEREBRAS_MODEL=

# OpenRouter - Additional fallback
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Together AI - Optional provider
TOGETHER_API_KEY=
TOGETHER_MODEL=


# ==========================================
# SUPABASE DATABASE
# ==========================================

SUPABASE_URL=

# Server-side secret key only
SUPABASE_SERVICE_KEY=

# Newer Supabase projects may provide this name instead. Use one backend secret key only.
SUPABASE_SECRET_KEY=
