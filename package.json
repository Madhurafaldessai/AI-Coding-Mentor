{
  "name": "ai-coding-mentor-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"npm run dev --workspace=@mentor/frontend\" \"npm run dev --workspace=@mentor/backend\"",
    "dev:frontend": "npm run dev --workspace=@mentor/frontend",
    "dev:backend": "npm run dev --workspace=@mentor/backend",
    "build": "npm run build --workspace=@mentor/backend && npm run build --workspace=@mentor/frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

